# Copy this file to .env.local and fill in the values (.env.local is not
# committed). NEXT_PUBLIC_ values are built into the browser bundle, so change
# them before building.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Required. Project URL and anon key. The browser uses them; Row Level
# Security decides what they can read and write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required. Service-role key (bypasses Row Level Security). Used only on the
# server: sign-up, the public booking page, reminder emails and links,
# billing, staff photo uploads and account deletion. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Required. Absolute URL of the app, without a trailing slash. Used for the
# links in emails, the password reset redirect and the Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, but /api/cron/send-reminders rejects every request while it is
# empty, so no 24-hour reminders go out. Any long random string, for example
# the output of `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Resend (email)
# ---------------------------------------------------------------------------

# Required to send email.
RESEND_API_KEY=

# Optional. Sender address on a domain verified in Resend, for example
# reminders@example.com. When empty, Resend's onboarding@resend.dev sender is
# used, which only delivers to the Resend account's own address.
RESEND_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Stripe (test mode keys for development)
# ---------------------------------------------------------------------------

# Required. Secret key; the billing routes and the webhook fail without it.
STRIPE_SECRET_KEY=

# Required. Signing secret of the webhook endpoint /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Required. Price id of the Basic plan, the plan sold at checkout.
STRIPE_BASIC_PRICE_ID=

# Optional. Price ids of the internal Pro and Business plans, only needed if a
# subscription uses them (the webhook does not apply prices it cannot map).
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Optional, legacy. Price ids of the old Starter and Professional plans,
# mapped to Basic and Pro.
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
